# Copy this file to .env, then fill in secrets locally:
#   cp .env.example .env
# Never put real API keys or production passwords in this example file.

LLM_PROVIDER=dashscope/qwen3.5-plus-2026-04-20
DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
TIMEZONE=Asia/Shanghai
CRAWL4_AI_BASE_DIRECTORY=.runtime
PLAYWRIGHT_BROWSERS_PATH=.runtime/ms-playwright
HOST=127.0.0.1
PORT=8000

# Comma-separated browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Direct PostgreSQL connection used outside Docker. Production requires SSL.
DATABASE_URL=postgresql://data_agent:change_me@127.0.0.1:5432/data_agent

# Local Docker Compose database settings. Change the password before sharing a
# running environment; Compose overrides DATABASE_URL for the API container.
POSTGRES_USER=policy_crawler
POSTGRES_PASSWORD=change_me
POSTGRES_DB=policy_crawler
POSTGRES_PORT=5433

# 高德 Web 端（JS API）Key，供资源选址卫星地图使用。
# 安全密钥在控制台该 Key 的详情里；2021-12 之后申请的 Key 必须填写。
# 白名单加上 http://127.0.0.1:3000
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_JS_CODE=

# Browser-visible API address, injected when the Next.js app is built.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Server-side API address. In cloud hosting, set this to the deployed FastAPI URL.
INTERNAL_API_URL=http://127.0.0.1:8000
